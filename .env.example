# ========================================================
# SABORES DE COCHABAMBA - CONFIGURACIÓN DE ENTORNO
# ========================================================

# Configuración del servidor backend
PORT=3000

# Configuración Supabase (PostgreSQL en la nube + Realtime)
# Obtén estos valores en tu panel de Supabase: Project Settings -> API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-service-role-o-anon-key
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

# Configuración alternativa de base de datos MySQL 8.x local (opcional)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sabores_cochabamba

# Autenticación y Seguridad
JWT_SECRET=clave_secreta_jwt_sabores_cochabamba_2026
ADMIN_DEFAULT_USER=edwin
ADMIN_DEFAULT_PASSWORD=anai1234
ADMIN_DEFAULT_NAME=Edwin - Administrador
